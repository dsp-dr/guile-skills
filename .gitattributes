# Generated files. `linguist-generated=true` collapses them in GitHub diffs and
# keeps them out of the language statistics, which is what you want for a file
# nobody edits by hand: the .org beside it is the source.
#
#   gmake readme    regenerates them from the .org sources
#
README.md        linguist-generated=true
CONTRIBUTING.md  linguist-generated=true

# Benchmark output from skill-creator: recorded evidence of what an agent
# produced, not authored source. Collapsed for the same reason.
evals/workspace/** linguist-generated=true

# Org is the authored form here; GitHub detects it, but be explicit so the
# language breakdown reflects what is actually written by hand.
*.org            linguist-documentation=false
