# guile-skills --- direnv entry point.  `direnv allow` once per checkout.
#
# Two layers on purpose: .env carries the declared values (no secrets, ${VAR}
# expansion only), .envrc derives anything that needs a real shell. A checkout
# with no .env still gets a correct environment from the defaults below, which
# is what makes this work on a fresh host.

dotenv_if_exists .env        # tracked template is .env.example
dotenv_if_exists .env.local  # personal, never tracked, wins over .env
watch_file .env .env.local

# Per-checkout scratch, derived rather than hard-coded: the basename of the git
# toplevel, so a worktree (guile-skills-feat-x) gets its own directory instead
# of racing the main checkout for the same one.
PROJECT_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
: "${CLAUDE_CODE_TMPDIR:=${XDG_CACHE_HOME:-${HOME}/.cache}/claude-code/$(basename "${PROJECT_ROOT}")}"
export CLAUDE_CODE_TMPDIR
mkdir -p "${CLAUDE_CODE_TMPDIR}"
chmod 700 "${CLAUDE_CODE_TMPDIR}"

# The skills' own scripts resolve their data directory from CLAUDE_PLUGIN_DATA
# (2dc20e9); leave it to the plugin runtime rather than pinning it here.

# GitHub credential for the GitHub MCP server, read from pass at shell entry.
#
# It is deliberately NOT in .env, and not in any file in this checkout. .env could
# not do it anyway -- direnv's dotenv parser expands ${VAR} and does not run
# commands -- but the reason to want it here is stronger than that: pass stays the
# single source of truth, and the value exists only in the environment of processes
# started from this directory. Nothing to gitignore, nothing to leak in a backup,
# nothing to forget to rotate in two places.
#
# Only the pass PATH is committed, which is the same rule scripts/secrets.map
# follows: names are safe, values never are.
#
# Tolerant on purpose: direnv evaluates this on every cd, and a locked gpg agent or
# a machine without this entry must not break the shell.
GUILE_SKILLS_GH_TOKEN_PATH=github/dsp-dr/personal-access-token
if command -v pass >/dev/null 2>&1 &&
       pass show "$GUILE_SKILLS_GH_TOKEN_PATH" >/dev/null 2>&1; then
    GITHUB_PERSONAL_ACCESS_TOKEN=$(pass show "$GUILE_SKILLS_GH_TOKEN_PATH" | head -n 1)
    export GITHUB_PERSONAL_ACCESS_TOKEN
fi
unset GUILE_SKILLS_GH_TOKEN_PATH
