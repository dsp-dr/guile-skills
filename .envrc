# guile-skills --- direnv entry point.  `direnv allow` once per checkout.
#
# Two layers on purpose: .env carries the declared values (no secrets, ${VAR}
# expansion only), .envrc derives anything that needs a real shell. A checkout
# with no .env still gets a correct environment from the defaults below, which
# is what makes this work on a fresh host.

dotenv_if_exists .env        # tracked template is .env.example
dotenv_if_exists .env.local  # personal, never tracked, wins over .env
watch_file .env .env.local

# Per-checkout scratch, derived rather than hard-coded: the basename of the git
# toplevel, so a worktree (guile-skills-feat-x) gets its own directory instead
# of racing the main checkout for the same one.
PROJECT_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
: "${CLAUDE_CODE_TMPDIR:=${XDG_CACHE_HOME:-${HOME}/.cache}/claude-code/$(basename "${PROJECT_ROOT}")}"
export CLAUDE_CODE_TMPDIR
mkdir -p "${CLAUDE_CODE_TMPDIR}"
chmod 700 "${CLAUDE_CODE_TMPDIR}"

# The skills' own scripts resolve their data directory from CLAUDE_PLUGIN_DATA
# (2dc20e9); leave it to the plugin runtime rather than pinning it here.
